# Bakery Platform — environment configuration
# Copy this file to `.env` and adjust the values before running docker-compose up.
#
#   cp .env.example .env
#   docker compose up --build

# --- PostgreSQL ---
POSTGRES_USER=bakery_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=bakery_db
POSTGRES_PORT=5432

# --- Backend ---
# JWT signing secret — REQUIRED. Generate one with:  openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
BACKEND_PORT=5000

# --- Frontend ---
FRONTEND_PORT=8080