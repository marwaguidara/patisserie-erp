# Bakery Platform — environment configuration
# Copy this file to `.env` and adjust the values before running docker-compose up.
#
#   cp .env.example .env
#   docker compose up --build

# --- MySQL (base unique : backend + ai-service) ---
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=bakery_user
MYSQL_PASSWORD=change_me_strong_password
MYSQL_DATABASE=patisserie_erp
MYSQL_PORT=3306

# --- Backend ---
# JWT signing secret — REQUIRED. Generate one with:  openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
BACKEND_PORT=5000

# --- Frontend ---
FRONTEND_PORT=8080

# --- AI Service ---
# Lit la même base MySQL que le backend (variables DB_* injectées par docker-compose).
AI_SERVICE_PORT=8000
